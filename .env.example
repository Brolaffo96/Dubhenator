# Token del bot, dal Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=

# Application ID (Client ID), dal Developer Portal -> General Information
CLIENT_ID=

# Opzionale: ID del server (guild) da usare in sviluppo per registrare i comandi
# istantaneamente (senza aspettare fino a 1h di propagazione globale).
# Lascialo vuoto per registrare i comandi globalmente (produzione).
GUILD_ID=
